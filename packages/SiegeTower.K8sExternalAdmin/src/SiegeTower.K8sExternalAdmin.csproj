<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>siegetower-k8s-external-admin</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<BaseOutputPath>../bin/</BaseOutputPath>
	</PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="KubernetesClient" Version="19.0.2" />
	</ItemGroup>

	<Target Name="CopyBuildOutputToDist" AfterTargets="Build">
		<ItemGroup>
			<BuildArtifacts Include="$(TargetDir)**/*" />
		</ItemGroup>
		<Copy SourceFiles="@(BuildArtifacts)" DestinationFiles="@(BuildArtifacts->'../dist/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
	</Target>
</Project>
