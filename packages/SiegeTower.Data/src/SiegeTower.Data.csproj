<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BaseOutputPath>../bin/</BaseOutputPath>
    <PublishDir>../dist/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SiegeTower.GraphQuery/src/SiegeTower.GraphQuery.csproj" />
    <ProjectReference Include="../../SiegeTower.ECS/src/SiegeTower.ECS.csproj" />
  </ItemGroup>

  <Target Name="CopyGraphQueryDist"
          BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <GraphQueryProject>$(MSBuildThisFileDirectory)..\..\SiegeTower.GraphQuery\src\SiegeTower.GraphQuery.csproj</GraphQueryProject>
      <GraphQueryDist>$(MSBuildThisFileDirectory)..\..\SiegeTower.GraphQuery\dist\</GraphQueryDist>
    </PropertyGroup>

    <MSBuild
      Projects="$(GraphQueryProject)"
      Targets="Publish"
      Properties="PublishAfterBuild=true" />

    <ItemGroup>
      <GraphQueryDistFiles Include="$(GraphQueryDist)**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(GraphQueryDistFiles)"
      DestinationFiles="@(GraphQueryDistFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(GraphQueryDistFiles)"
      DestinationFiles="@(GraphQueryDistFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyEcsDist"
          BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <EcsProject>$(MSBuildThisFileDirectory)..\..\SiegeTower.ECS\src\SiegeTower.ECS.csproj</EcsProject>
      <EcsDist>$(MSBuildThisFileDirectory)..\..\SiegeTower.ECS\dist\</EcsDist>
    </PropertyGroup>

    <MSBuild
      Projects="$(EcsProject)"
      Targets="Publish"
      Properties="PublishAfterBuild=true" />

    <ItemGroup>
      <EcsDistFiles Include="$(EcsDist)**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(EcsDistFiles)"
      DestinationFiles="@(EcsDistFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(EcsDistFiles)"
      DestinationFiles="@(EcsDistFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishAfterBuild"
          AfterTargets="Build"
          Condition="'$(PublishAfterBuild)' != 'true'">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="PublishAfterBuild=true" />
  </Target>
</Project>