@if (WorkspaceFilesScreenData.IsLoadedOnce)
{
	<div class="workspace-files-screen ux-box">
		<TitleBarView />
		<WorkspaceFilesToolbarView ToolbarGrid="WorkspaceFilesScreenData.ToolbarGrid" />
		@if (LoadError is not null)
		{
			<div class="ux-padded">Unable to load workspace files: @LoadError.Message</div>
		}
		else
		{
			<DockGridView DockGrid="WorkspaceFilesScreenData.DockGrid" />
		}
	}
</div>
}

@code {
	[Parameter, EditorRequired]
	public WorkspaceFilesScreenData WorkspaceFilesScreenData { get; set; } = null!;

	private Exception? LoadError { get; set; }

}