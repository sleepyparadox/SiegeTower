@if (WorkspaceFilesScreen.LoadingQueue.IsLoading)
	{
	<LoadingQueueView />
}
else
{
	<div class="workspace-files-screen ux-box">
		<TitleBarView />
		<WorkspaceFilesToolbarView ToolbarGrid="WorkspaceFilesScreen.ToolbarGrid" />
		@if (LoadError is not null)
		{
			<div class="ux-padded">Unable to load workspace files: @LoadError.Message</div>
		}
		else
		{
			<DockGridView DockGrid="WorkspaceFilesScreen.DockGrid" />
		}
	}
</div>
}

@code {
	[Parameter, EditorRequired]
	public WorkspaceFilesScreen WorkspaceFilesScreen { get; set; } = null!;

	private Exception? LoadError { get; set; }

	protected override async Task OnInitializedAsync()
	{
		try
		{
			await WorkspaceFilesScreen.LoadAsync();
		}
		catch (Exception exception)
		{
			LoadError = exception;
		}
	}
}