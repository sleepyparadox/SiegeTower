<div class="dock-view">
    <div class="dock-tabs" role="tablist">
        @foreach (var content in Dock.Contents)
        {
            <button type="button"
                    class="dock-tab @(ReferenceEquals(content, Dock.ActiveContent) ? "active" : "")"
                    @onclick="() => ActivateContent(content)">
                @content.GetType().Name
            </button>
        }
    </div>

    <div class="dock-content">
        @if (Dock.ActiveContentType == typeof(PodListDockContent) && Dock.ActiveContent is PodListDockContent podListContent)
        {
            <PodListDockView Content="podListContent" />
        }
        else if (Dock.ActiveContentType == typeof(ColorDockContent) && Dock.ActiveContent is ColorDockContent colorContent)
        {
            <ColorDockContentView Content="colorContent" />
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public Dock Dock { get; set; } = null!;

    private void ActivateContent(object content)
    {
        Dock.ActiveContent = content;
    }
}