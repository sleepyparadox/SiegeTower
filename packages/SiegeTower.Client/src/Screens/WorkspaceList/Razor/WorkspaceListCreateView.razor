@using SiegeTower.Client.UX

<section class="workspace-create-panel ux-box ux-padded">
	<label for="workspace-name">Create workspace</label>
	<input id="workspace-name" @bind="Content.WorkspaceName" placeholder="st-workspace-x" />
	<button class="refresh-button" type="button" @onclick="CreateWorkspaceAsync" disabled="@Content.IsCreating">
		@(Content.IsCreating ? "Creating..." : "Create")
	</button>
</section>

@code {
	[Parameter, EditorRequired]
	public WorkspaceListCreateContent Content { get; set; } = null!;

	private async Task CreateWorkspaceAsync()
	{
		await Content.CreateAsync();
	}
}
