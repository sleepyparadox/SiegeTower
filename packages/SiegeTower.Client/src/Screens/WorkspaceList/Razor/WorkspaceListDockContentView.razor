@using SiegeTower.Data

<div class="ux-box ux-height-fill">
	<table class="data-table ux-width-fill">
		<thead>
			<tr class="ux-line">
				<th><div class="ux-padded">Name</div></th>
				<th><div class="ux-padded">Namespace</div></th>
				<th><div class="ux-padded">Actions</div></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var workspace in Content.Workspaces)
			{
				<tr class="ux-line">
					<td><div class="ux-padded">@workspace.Name</div></td>
					<td><div class="ux-padded">@workspace.Namespace</div></td>
					<td>
						<div class="ux-line ux-padded">
							<button type="button" @onclick="() => Content.OpenWorkspace(workspace.Name)">Open</button>
							<button type="button" @onclick="() => Content.DeleteWorkspaceAsync(workspace.Name)">Delete</button>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
</div>

@code {
	[Parameter, EditorRequired]
	public WorkspaceListDockContent Content { get; set; } = null!;
}
