@inject IJSRuntime JS

<div class="ux-box ux-padded">
	<input class="ux-width-fill" placeholder="GitHub App ID" @bind="Content.AppId" />
	<input class="ux-width-fill" placeholder="GitHub App installation ID" @bind="Content.InstallationId" />
	<textarea class="ux-width-fill" rows="10" placeholder="Paste GitHub App private key" @bind="Content.PrivateKey"></textarea>
	<button type="button" disabled="@Content.IsGenerating" @onclick="GenerateAccessTokenAsync">
		@(Content.IsGenerating ? "Generating..." : "Generate New Access Token")
	</button>
	@if (Content.AccessToken is not null)
	{
		<div class="ux-line">Token expires: @Content.AccessToken.ExpiresAt.ToUniversalTime().ToString("u")</div>
		<textarea class="ux-width-fill" rows="4" readonly>@Content.AccessToken.Token</textarea>
		<button type="button" @onclick="CopyAccessTokenAsync">Copy Access Token</button>
	}
	@if (Content.Error is not null)
	{
		<div class="ux-line">@Content.Error.Message</div>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public WorkspaceGitAuthContent Content { get; set; } = null!;

	[Parameter, EditorRequired]
	public WorkspaceListScreenData Data { get; set; } = null!;

	private Task GenerateAccessTokenAsync() => Data.System.GenerateAccessTokenAsync(Data);

	private async Task CopyAccessTokenAsync()
	{
		if (Content.AccessToken is not null)
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", Content.AccessToken.Token);
		}
	}
}