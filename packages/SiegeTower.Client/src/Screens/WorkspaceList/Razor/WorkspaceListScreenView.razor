@if (WorkspaceListScreenData.LoadingQueue.IsLoading)
{
	<LoadingQueueView />
}
else
{
	<div class="workspace-list-screen ux-box">
		<TitleBarView />
		<ToolbarGridView ToolbarGrid="WorkspaceListScreenData.ToolbarGrid" />
		<DockGridView DockGrid="WorkspaceListScreenData.DockGrid" />
	</div>
}

@code {
	[Parameter, EditorRequired]
	public WorkspaceListScreenData WorkspaceListScreenData { get; set; } = null!;

}