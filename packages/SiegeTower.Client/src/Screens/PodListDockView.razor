@using SiegeTower.Data

<div class="ux-box ux-height-fill">
    <table class="data-table ux-width-fill">
        <thead>
            <tr class="ux-line">
                <th><div class="ux-padded">Name</div></th>
                <th><div class="ux-padded">Namespace</div></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pod in Content.Pods)
            {
                <tr class="ux-line">
                    <td><div class="ux-padded">@pod.Name</div></td>
                    <td><div class="ux-padded">@pod.Namespace</div></td>
                </tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter, EditorRequired]
    public PodListDockContent Content { get; set; } = null!;
}
