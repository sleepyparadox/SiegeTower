@using SiegeTower.Data

<div class="operation-history-content ux-box ux-height-fill">
	@foreach (var operation in Content.Operations)
	{
		<div class="operation-history-item ux-line ux-padded">
			<div>
				<strong>@operation.CreatedAt.ToLocalTime().ToString("g")</strong>
				<div>@GetOperationName(operation)</div>
			</div>
			<div>
				@foreach (var log in Content.GetLogs(operation))
				{
					<div class="operation-history-log">
						<span>@log.CreatedAt.ToLocalTime().ToString("T")</span>
						<span>@log.Message</span>
					</div>
				}
			</div>
		</div>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public OperationHistoryContent Content { get; set; } = null!;

	private static string GetOperationName(WorkspaceOperation operation)
	{
		if (operation.Operation.Prompt is not null)
		{
			return operation.Operation.Prompt.Prompt;
		}

		if (operation.Operation.GitClone is not null)
		{
			return $"Clone {operation.Operation.GitClone.Repo}";
		}

		if (operation.Operation.GitCreateBranch is not null)
		{
			return $"Create branch {operation.Operation.GitCreateBranch.Branch}";
		}

		if (operation.Operation.GitPushOperation is not null)
		{
			return $"Push branch {operation.Operation.GitPushOperation.Branch}";
		}

		if (operation.Operation.GitCommitOperation is not null)
		{
			return $"Commit {operation.Operation.GitCommitOperation.Message}";
		}

		return "Operation";
	}
}
