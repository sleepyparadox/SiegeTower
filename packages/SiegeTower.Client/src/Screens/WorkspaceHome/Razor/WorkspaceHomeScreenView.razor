@if (WorkspaceHomeScreenData.LoadingQueue.IsLoading)
{
	<LoadingQueueView />
}
else
{
	<div class="workspace-home-screen ux-box">
		<TitleBarView />
		<ToolbarGridView ToolbarGrid="WorkspaceHomeScreenData.ToolbarGrid" />
			<DockGridView DockGrid="WorkspaceHomeScreenData.DockGrid" SendMethod="@(operation => WorkspaceHomeScreenData.System.SendMethod(WorkspaceHomeScreenData, operation))" />
	</div>
}

@code {
	[Parameter, EditorRequired]
	public WorkspaceHomeScreenData WorkspaceHomeScreenData { get; set; } = null!;

}