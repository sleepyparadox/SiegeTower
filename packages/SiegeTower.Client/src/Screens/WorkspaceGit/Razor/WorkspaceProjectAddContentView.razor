<div class="ux-box ux-padded">
	<input class="ux-width-fill" placeholder="Namespace" @bind="Content.Namespace" />
	<input class="ux-width-fill" placeholder="Git repository" @bind="Content.GitRepo" />
	<button type="button" disabled="@Content.IsAdding" @onclick="Content.AddAsync">
		@(Content.IsAdding ? "Adding..." : "Add Project")
	</button>
	@if (Content.Error is not null)
	{
		<div class="ux-line">@Content.Error.Message</div>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public WorkspaceProjectAddContent Content { get; set; } = null!;
}