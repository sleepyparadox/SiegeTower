<div class="workspace-git-screen ux-box">
	<TitleBarView />
	<WorkspaceGitToolbarView ToolbarGrid="WorkspaceGitScreen.ToolbarGrid" />
	<DockGridView DockGrid="WorkspaceGitScreen.DockGrid" />
</div>

@code {
	[Parameter, EditorRequired]
	public WorkspaceGitScreen WorkspaceGitScreen { get; set; } = null!;

	protected override async Task OnInitializedAsync()
	{
		await WorkspaceGitScreen.LoadAsync();
	}

}