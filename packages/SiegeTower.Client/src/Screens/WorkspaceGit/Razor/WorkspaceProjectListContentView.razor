@using SiegeTower.Data

<div class="ux-box ux-height-fill">
	@foreach (var project in Content.Projects)
	{
		<div class="ux-line ux-padded">
			<div>@project.Namespace</div>
			<div class="ux-line">
				<div>@project.GitRepo</div>
				<button type="button" @onclick="() => Content.PullProjectAsync(project.Namespace)">Pull</button>
			</div>
		</div>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public WorkspaceProjectListContent Content { get; set; } = null!;
}