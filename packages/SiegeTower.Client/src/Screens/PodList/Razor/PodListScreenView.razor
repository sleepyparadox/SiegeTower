<div class="pod-list-screen ux-box">
	<TitleBarView />
	<ToolbarGridView ToolbarGrid="PodListScreen.ToolbarGrid" />
	<DockGridView DockGrid="PodListScreen.DockGrid" />
</div>

@code {
	[Parameter, EditorRequired]
	public PodListScreen PodListScreen { get; set; } = null!;

	protected override async Task OnInitializedAsync()
	{
		await PodListScreen.LoadAsync();
	}
}