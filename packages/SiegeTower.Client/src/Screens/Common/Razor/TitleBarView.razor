<div class="title-bar ux-box ux-line-x2 ux-width-fill ux-padded ux-center-vertically">
	<button type="button" class="title-bar-menu" aria-label="Open menu" @onclick="ToggleBurgerMenu">
		<i class="fa-solid fa-bars" aria-hidden="true"></i>
	</button>
	@if (isBurgerMenuOpen)
	{
		<div class="title-bar-burger-menu">
			@foreach (var menuItem in Session.Data.BurgerMenu)
			{
				<button type="button" class="ux-height-line" @onclick="() => SelectMenuItem(menuItem)">
					@menuItem.Name
				</button>
			}
		</div>
	}
	<i class="fa-solid fa-tower-observation" aria-hidden="true"></i>
	<span class="title-bar-breadcrumbs">
		@foreach (var (breadCrumb, index) in Session.Data.BreadCrumbs.Select((value, index) => (value, index)))
		{
			@if (index > 0)
			{
				<span> / </span>
			}
			<BreadCrumbView BreadCrumb="breadCrumb" />
		}
	</span>
</div>

@code {
	[Inject]
	private SessionBlazorHandler Session { get; set; } = null!;

	private bool isBurgerMenuOpen;

	private void ToggleBurgerMenu()
	{
		isBurgerMenuOpen = !isBurgerMenuOpen;
	}

	private void SelectMenuItem(MenuItem menuItem)
	{
		isBurgerMenuOpen = false;
		menuItem.Action();
	}
}