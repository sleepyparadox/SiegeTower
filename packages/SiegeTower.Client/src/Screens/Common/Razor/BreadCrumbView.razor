<a href="@BreadCrumb.Uri" @onclick="HandleClick" @onclick:preventDefault="true">
	@BreadCrumb.Text
</a>

@code {
	[Inject]
	private Session Session { get; set; } = null!;

	[Parameter, EditorRequired]
	public BreadCrumb BreadCrumb { get; set; } = null!;

	private void HandleClick(MouseEventArgs args)
	{
		if (args.Button == 0)
		{
			Session.NavigateTo(BreadCrumb.Uri);
		}
	}
}
