<div class="ux-box ux-height-fill">
	<table class="data-table ux-width-fill">
		<thead>
			<tr class="ux-line">
				<th><div class="ux-padded">Model</div></th>
				<th><div class="ux-padded">Action</div></th>
			</tr>
		</thead>
		<tbody>
			@foreach (var model in Content.OllamaScreen.Models)
			{
				<tr class="ux-line">
					<td><div class="ux-padded">@model.Name</div></td>
					<td><button type="button" @onclick="() => DeleteAsync(model.Name)">Delete</button></td>
				</tr>
			}
			<tr class="ux-line">
				<td><input @bind="ModelName" placeholder="Model name" /></td>
				<td><button type="button" @onclick="AddAsync" disabled="@string.IsNullOrWhiteSpace(ModelName)">Add Model</button></td>
			</tr>
		</tbody>
	</table>
</div>

@code {
	[Parameter, EditorRequired]
	public ModelsContent Content { get; set; } = null!;

	private string ModelName { get; set; } = string.Empty;

	private async Task DeleteAsync(string model)
	{
		await Content.OllamaScreen.DeleteModelAsync(model);
	}

	private async Task AddAsync()
	{
		var model = ModelName.Trim();
		if (model.Length == 0)
		{
			return;
		}

		await Content.OllamaScreen.AddModelAsync(model);
		ModelName = string.Empty;
	}
}