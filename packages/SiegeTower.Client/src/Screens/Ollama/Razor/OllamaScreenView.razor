@if (OllamaScreenData.LoadingQueue.IsLoading)
{
	<LoadingQueueView />
}
else
{
	<div class="ollama-screen ux-box">
		<TitleBarView />
		<DockGridView DockGrid="OllamaScreenData.DockGrid" />
	</div>
}

@code {
	[Parameter, EditorRequired]
	public OllamaScreenData OllamaScreenData { get; set; } = null!;

}