
<div class="chat-history-content ux-box ux-height-fill">
	<div class="chat-history-new-chat ux-line ux-padded"
		 @onclick="() => Content.Data.System.NewChat(Content.Data)">
		<span role="button" tabindex="0">New chat</span>
	</div>
	<div class="chat-history-splitter ux-line" aria-hidden="true"></div>
	<div class="chat-history-list ux-box ux-height-fill">
		@for (var index = 0; index < Content.Data.Chats.Count; index++)
		{
			var chat = Content.Data.Chats[index];
			<div class="chat-history-row ux-line ux-padded"
				 @onclick="() => Content.Data.System.OpenChat(Content.Data, chat)">
				<span role="button" tabindex="0">Chat @(index + 1)</span>
			</div>
		}
	</div>
</div>

@code {
	[Parameter, EditorRequired]
	public ChatHistoryContent Content { get; set; } = null!;
}