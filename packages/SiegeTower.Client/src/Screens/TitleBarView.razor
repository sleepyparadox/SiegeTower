<div class="title-bar ux-box ux-line-x2 ux-padded ux-center-vertically">
    <button type="button" class="title-bar-menu" aria-label="Open menu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
    </button>
    <i class="fa-solid fa-tower-observation" aria-hidden="true"></i>
    <span class="title-bar-breadcrumbs">@string.Join(" / ", TitleBar.Breadcrumbs)</span>
</div>

@code {
    [Parameter, EditorRequired]
    public TitleBar TitleBar { get; set; } = null!;
}