@namespace SiegeTower.Client.UX

@inject IJSRuntime JS
@inject SessionBlazorHandler Session

<div @ref="HorizontalScrollElement"
	 class="ux-line ux-width-fill ux-horizontal-gap ux-scroll-horizontal"
	 @onmouseup="() => Session.System.DragStop(Toolbar)">
	<i class="fa-solid fa-grip-vertical ux-i-dragable"
	   aria-hidden="true"
	@onmousedown="StartPreviewDrag"
	   @onmouseup="() => Session.System.DragStop(Toolbar)"></i>
	@foreach (var item in Toolbar.Items)
	{
		<button type="button" @onclick="item.OnClick">@item.Label</button>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public Toolbar Toolbar { get; set; } = null!;

	private ElementReference HorizontalScrollElement { get; set; }

	private async Task StartPreviewDrag()
	{
		Session.System.DragStart(Toolbar);
		await JS.InvokeVoidAsync("window.siegetower.drag.DragStart", "Preview");
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("window.siegetower.ux.SetHorizontalScrollable", HorizontalScrollElement);
		}
	}
}
