@namespace SiegeTower.Client.UX

	<div class="ux-width-fill" @onmouseup="() => Session.System.DragStop(ToolbarGrid)">
	@foreach (var toolbar in ToolbarGrid.Toolbars)
	{
		<ToolbarView Toolbar="toolbar" />
	}
</div>

@code {
	[Inject]
	private SessionBlazorHandler Session { get; set; } = null!;

	[Parameter, EditorRequired]
	public ToolbarGrid ToolbarGrid { get; set; } = null!;
}