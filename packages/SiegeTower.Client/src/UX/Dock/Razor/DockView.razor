@namespace SiegeTower.Client.UX
@using SiegeTower.Client.Screens.WorkspaceFiles.Razor
@using SiegeTower.Client.Screens.WorkspaceGit
@using SiegeTower.Client.Screens.WorkspaceGit.Razor
@using SiegeTower.Client.Screens.WorkspaceHome
@using SiegeTower.Client.Screens.WorkspaceHome.Razor

@inject IJSRuntime JS
@inject Session Session

<div class="dock-view ux-box ux-height-fill" @onmouseup="() => DragStop(Dock)">
	<div @ref="HorizontalScrollElement"
		 class="dock-tabs ux-line ux-width-fill ux-horizontal-gap ux-scroll-horizontal"
		 role="tablist">
		@foreach (var content in Dock.Contents)
		{
			<button type="button"
					class="dock-tab ux-i-draggable ux-padded @(ReferenceEquals(content, Dock.ActiveContent) ? "active" : "")"
					@onmousedown="() => StartPreviewDrag(content)"
					@onmouseup="() => Session.DragStop(content)"
					@onclick="() => ActivateContent(content)">
				@content.Name
			</button>
		}
	</div>

	<div class="dock-content ux-box ux-height-fill" @onmouseup="() => DragStop(Dock.ActiveContent)">
		@if (Dock.ActiveContent is WorkspaceListDockContent workspaceListContent)
		{
			<WorkspaceListDockContentView Content="workspaceListContent" />
		}
		else if (Dock.ActiveContent is WorkspaceListCreateContent workspaceListCreateContent)
		{
			<WorkspaceListCreateView Content="workspaceListCreateContent" />
		}
		else if (Dock.ActiveContent is ColorDockContent colorContent)
		{
			<ColorDockContentView Content="colorContent" />
		}
		else if (Dock.ActiveContent is ChatHistoryContent chatHistoryContent)
		{
			<ChatHistoryContentView Content="chatHistoryContent" />
		}
		else if (Dock.ActiveContent is ChatPrimaryContent chatPrimaryContent)
		{
			<ChatPrimaryContentView Content="chatPrimaryContent" />
		}
		else if (Dock.ActiveContent is ModelsContent modelsContent)
		{
			<ModelsContentView Content="modelsContent" />
		}
		else if (Dock.ActiveContent is FileTreeDockContent fileTreeDockContent)
		{
			<FileTreeDockContentView Content="fileTreeDockContent" />
		}
		else if (Dock.ActiveContent is FileEditDockContent fileEditDockContent)
		{
			<FileEditDockContentView Content="fileEditDockContent" />
		}
		else if (Dock.ActiveContent is WorkspaceProjectListContent workspaceProjectListContent)
		{
			<WorkspaceProjectListContentView Content="workspaceProjectListContent" />
		}
		else if (Dock.ActiveContent is WorkspaceProjectAddContent workspaceProjectAddContent)
		{
			<WorkspaceProjectAddContentView Content="workspaceProjectAddContent" />
		}
		else if (Dock.ActiveContent is WorkspaceGitAuthContent workspaceGitAuthContent)
		{
			<WorkspaceGitAuthContentView Content="workspaceGitAuthContent" Screen="@GetWorkspaceGitScreen(workspaceGitAuthContent)" />
		}
		else if (Dock.ActiveContent is OperationHistoryContent operationHistoryContent)
		{
			<OperationHistoryContentView Content="operationHistoryContent" />
		}
		else if (Dock.ActiveContent is IDockContent operationDockContent
			&& (operationDockContent is GitCloneOperationDockContent
				|| operationDockContent is GitCreateBranchOperationDockContent
				|| operationDockContent is GitPushOperationDockContent
				|| operationDockContent is GitCommitOperationDockContent
				|| operationDockContent is PromptOperationDockContent))
		{
			<OperationDockContentViews Content="operationDockContent" SendMethod="SendMethod" />
		}
		else if (Dock.ActiveContent is WorkspaceSettingsDockContent workspaceSettingsDockContent)
		{
			<WorkspaceSettingsDockContentView Content="workspaceSettingsDockContent" />
		}
	</div>
</div>

@code {
	[Parameter, EditorRequired]
	public Dock Dock { get; set; } = null!;

	[Parameter]
	public Func<Operation, Task>? SendMethod { get; set; }

	private ElementReference HorizontalScrollElement { get; set; }

	private void ActivateContent(IDockContent content)
	{
		Dock.ActiveContent = content;
	}

	private WorkspaceGitScreen GetWorkspaceGitScreen(WorkspaceGitAuthContent content)
	{
		return Session.ActiveScreen as WorkspaceGitScreen
			?? throw new InvalidOperationException("Git auth content is not hosted by a Git screen.");
	}

	private void DragStop(object? content)
	{
		if (content is not null)
		{
			Session.DragStop(content);
		}
	}

	private async Task StartPreviewDrag(IDockContent content)
	{
		Session.DragStart(content);
		await JS.InvokeVoidAsync("window.siegetower.drag.DragStart", "Preview");
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await JS.InvokeVoidAsync("window.siegetower.ux.SetHorizontalScrollable", HorizontalScrollElement);
		}
	}
}
