@namespace SiegeTower.Client.UX

@inject SessionBlazorHandler Session
@inject IJSRuntime JS

<div class="ux-dock-row ux-box ux-height-fill">
	@if (!DockGrid.Left.IsHidden)
	{
		<div class="ux-dock ux-box ux-width-sidedock-default ux-drag-dock-width-left">
			<DockView Dock="DockGrid.Left" SendMethod="SendMethod" />
		</div>
	}
	<div class="ux-box ux-width-sidedock-divider ux-i-draggable" aria-hidden="true"
		@onmousedown="StartLeftWidthDrag"
		@onmouseup="() => Session.System.DragStop(DockGrid.LeftDivider)"
		@ondblclick="ToggleLeftDock">
	</div>
	<div class="ux-dock ux-box">
		<DockView Dock="DockGrid.Center" SendMethod="SendMethod" />
	</div>
	<div class="ux-box ux-width-sidedock-divider ux-i-draggable" aria-hidden="true"
		@onmousedown="StartRightWidthDrag"
		@onmouseup="() => Session.System.DragStop(DockGrid.RightDivider)"
		@ondblclick="ToggleRightDock">
	</div>
	@if (!DockGrid.Right.IsHidden)
	{
		<div class="ux-dock ux-box ux-width-sidedock-default ux-drag-dock-width-right">
			<DockView Dock="DockGrid.Right" SendMethod="SendMethod" />
		</div>
	}
</div>

@code {
	[Parameter, EditorRequired]
	public DockGrid DockGrid { get; set; } = null!;

	[Parameter]
	public Func<Operation, Task>? SendMethod { get; set; }

	private Task StartLeftWidthDrag()
	{
		return StartWidthDrag(DockGrid.LeftDivider, "DragDockWidthLeft");
	}

	private Task StartRightWidthDrag()
	{
		return StartWidthDrag(DockGrid.RightDivider, "DragDockWidthRight");
	}

	private void ToggleLeftDock()
	{
		DockGrid.Left.IsHidden = !DockGrid.Left.IsHidden;
		Session.System.Redraw();
	}

	private void ToggleRightDock()
	{
		DockGrid.Right.IsHidden = !DockGrid.Right.IsHidden;
		Session.System.Redraw();
	}

	private async Task StartWidthDrag(DockGrid.Divider divider, string dragType)
	{
		Session.System.DragStart(divider);
		await JS.InvokeVoidAsync("window.siegetower.drag.DragStart", dragType);
	}
}
