@code {
	protected bool IsLoading { get; private set; }

	public void Clear()
	{
		IsLoading = false;
		StateHasChanged();
	}

	public void ShowLoading()
	{
		IsLoading = true;
		StateHasChanged();
	}

	protected virtual Task RefreshPressedAsync()
	{
		return Task.CompletedTask;
	}

	public async Task RefreshAsync()
	{
		ShowLoading();
		await RefreshPressedAsync();
		Clear();
	}
}