@using SiegeTower.Data
@inherits OldCrudTable

<section class="crud-table">
	@if (IsLoading)
	{
		<div class="crud-loading" role="status">Loading...</div>
	}

	<div class="table-wrap">
	<table class="data-table">
		<thead>
			<tr>
				<th>Name</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var workspace in workspaces)
			{
				<tr>
					<td>@workspace.Name</td>
				</tr>
			}
		</tbody>
	</table>
	</div>
</section>

@code {
	[Parameter, EditorRequired]
	public SessionContext SessionContext { get; set; } = null!;

	private IReadOnlyList<WorkspaceRow> workspaces = [];

	protected override async Task OnInitializedAsync()
	{
		await RefreshAsync();
	}

	protected override async Task RefreshPressedAsync()
	{
		workspaces = await APIService.Get<WorkspaceRow>(SessionContext);
	}
}