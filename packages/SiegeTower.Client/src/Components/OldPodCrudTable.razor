@using SiegeTower.Data
@inherits OldCrudTable

<section class="crud-table">
	@if (IsLoading)
	{
		<div class="crud-loading" role="status">Loading...</div>
	}

	<div class="table-wrap">
	<table class="data-table">
		<thead>
			<tr>
				<th>Name</th>
				<th>Namespace</th>
				<th>Actions</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var workspace in workspaces)
			{
				<tr>
					<td>@workspace.Name</td>
					<td>@workspace.Namespace</td>
					<td class="row-actions">
						<a class="table-action" href="@GetWorkspaceUrl(workspace)" target="_blank" rel="noopener">View</a>
						<button class="table-action danger" type="button" @onclick="() => DeleteWorkspaceAsync(workspace.Name)" disabled="@(deletingWorkspaceName is not null)">Delete</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
	</div>

	<div class="workspace-create-panel">
		<label for="workspace-name">Create workspace</label>
		<input id="workspace-name" @bind="workspaceName" placeholder="st-workspace-x" />
		<button class="refresh-button" type="button" @onclick="CreateWorkspaceAsync" disabled="@IsCreating">
			@(IsCreating ? "Creating..." : "Create")
		</button>
	</div>
</section>

@code {
	[Parameter, EditorRequired]
	public SessionContext SessionContext { get; set; } = null!;

	private IReadOnlyList<WorkspaceRow> workspaces = [];
	private string workspaceName = "st-workspace-x";
	private bool IsCreating;
	private string? deletingWorkspaceName;

	protected override async Task OnInitializedAsync()
	{
		await RefreshAsync();
	}

	protected override async Task RefreshPressedAsync()
	{
		workspaces = await APIService.Get<WorkspaceRow>(SessionContext);
	}

	private async Task CreateWorkspaceAsync()
	{
		if (string.IsNullOrWhiteSpace(workspaceName))
		{
			return;
		}

		IsCreating = true;
		try
		{
			await APIService.CreateWorkspace(SessionContext, workspaceName.Trim());
			await RefreshAsync();
		}
		finally
		{
			IsCreating = false;
		}
	}

	private async Task DeleteWorkspaceAsync(string name)
	{
		deletingWorkspaceName = name;
		try
		{
			await APIService.DeleteWorkspace(SessionContext, name);
			await RefreshAsync();
		}
		finally
		{
			deletingWorkspaceName = null;
		}
	}

	private static string GetWorkspaceUrl(WorkspaceRow workspace)
	{
		const string prefix = "st-workspace-";
		var id = workspace.Name.StartsWith(prefix, StringComparison.Ordinal)
			? workspace.Name[prefix.Length..]
			: workspace.Name;
		return $"/workspace/{Uri.EscapeDataString(id)}/api";
	}
}