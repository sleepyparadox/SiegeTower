@using SiegeTower.Data
@inherits CrudTable

<section class="crud-table">
    @if (IsLoading)
    {
        <div class="crud-loading" role="status">Loading...</div>
    }

    <div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Namespace</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pod in pods)
            {
                <tr>
                    <td>@pod.Name</td>
                    <td>@pod.Namespace</td>
                </tr>
            }
        </tbody>
    </table>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public SessionContext SessionContext { get; set; } = null!;

    private IReadOnlyList<Pod> pods = [];

    protected override async Task OnInitializedAsync()
    {
        await RefreshAsync();
    }

    protected override async Task RefreshPressedAsync()
    {
        pods = await APIService.Get<Pod>(SessionContext);
    }
}