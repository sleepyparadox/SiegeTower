@page "/"
@inject AppService AppService
@implements IDisposable

<PageTitle>@AppService.ActiveScreen.Title</PageTitle>

<div class="app-background" @onmouseup="StopDrag">
	@if (AppService.ActiveScreen is PodListScreen podListScreen)
	{
		<PodListScreenView PodListScreen="podListScreen" />
	}

	<div id="DragPreview"
	     class="drag-preview @(AppService.DragOperation.Target is not null ? "drag-preview-active" : "")"
	     aria-hidden="true">
		@if (AppService.DragOperation.Target is not null)
		{
			@switch (AppService.DragOperation.Target)
			{
				case Toolbar toolbar:
					<ToolbarDragPreview Toolbar="toolbar" />
					break;
				case IDockContent dockContent:
					<DockTabDragPreview Content="dockContent" />
					break;
				default:
					<div>no preview</div>
					break;
			}
		}
	</div>
</div>

@code {
	protected override void OnInitialized()
	{
		AppService.RedrawRequested += HandleRedrawRequested;
	}

	private void HandleRedrawRequested(object? sender, EventArgs args)
	{
		_ = InvokeAsync(StateHasChanged);
	}

	private void StopDrag(MouseEventArgs args)
	{
		AppService.DragStop(args);
	}

	public void Dispose()
	{
		AppService.RedrawRequested -= HandleRedrawRequested;
	}
}