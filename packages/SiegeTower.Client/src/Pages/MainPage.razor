@page "/"
@inject AppService AppService
@implements IDisposable

<PageTitle>@AppService.ActiveScreen.Title</PageTitle>

@if (AppService.ActiveScreen is PodListScreen podListScreen)
{
	<PodListScreenView PodListScreen="podListScreen" />
}

@code {
	protected override void OnInitialized()
	{
		AppService.RedrawRequested += HandleRedrawRequested;
	}

	private void HandleRedrawRequested(object? sender, EventArgs args)
	{
		_ = InvokeAsync(StateHasChanged);
	}

	public void Dispose()
	{
		AppService.RedrawRequested -= HandleRedrawRequested;
	}
}