@page "/"
@using SiegeTower.Data

<PageTitle>SiegeTower</PageTitle>

<div class="dashboard-shell">
    <aside class="dashboard-sidebar">
        <div class="brand-mark">SiegeTower</div>
        <div class="sidebar-label">Explore</div>
        <button class="sidebar-option @(showWorkspaces ? "selected" : "")" type="button" @onclick="ShowWorkspaces">
            <span>Workspaces</span>
        </button>
        <button class="sidebar-option @(!showWorkspaces ? "selected" : "")" type="button" @onclick="ShowPods">
            <span>Pods</span>
        </button>
    </aside>

    <main class="dashboard-main">
        <header class="dashboard-header">
            <div>
                <div class="eyebrow">Control plane</div>
                <h1>@(showWorkspaces ? "Workspaces" : "Pods")</h1>
            </div>
            <button class="refresh-button" type="button" @onclick="RefreshCurrentTable" disabled="@IsRefreshing">
                @(IsRefreshing ? "Loading..." : "Refresh")
            </button>
        </header>

        <div class="dashboard-content">
            @if (showWorkspaces)
            {
                <WorkspaceCrudTable @ref="workspaceTable" SessionContext="sessionContext" />
            }
            else
            {
                <PodCrudTable @ref="podTable" SessionContext="sessionContext" />
            }
        </div>
    </main>
</div>

@code {
    private readonly SessionContext sessionContext = new() { ApiBase = "localhost:5006/api" };
    private bool showWorkspaces = true;
    private bool IsRefreshing;
    private WorkspaceCrudTable? workspaceTable;
    private PodCrudTable? podTable;

    private async Task RefreshCurrentTable()
    {
        IsRefreshing = true;
        try
        {
            if (showWorkspaces && workspaceTable is not null)
            {
                await workspaceTable.RefreshAsync();
            }
            else if (!showWorkspaces && podTable is not null)
            {
                await podTable.RefreshAsync();
            }
        }
        finally
        {
            IsRefreshing = false;
        }
    }

    private void ShowWorkspaces()
    {
        showWorkspaces = true;
    }

    private void ShowPods()
    {
        showWorkspaces = false;
    }
}