@page "/"
@inject Session Session
@implements IDisposable

<PageTitle>@Session.ActiveScreen.Title</PageTitle>

<div class="app-background" @onmouseup="StopDrag">
	@if (Session.ActiveScreen is PodListScreen podListScreen)
	{
		<PodListScreenView PodListScreen="podListScreen" />
	}

	<div id="DragPreview"
	     class="drag-preview @(Session.DragOperation.Target is not null ? "drag-preview-active" : "")"
	     aria-hidden="true">
		@if (Session.DragOperation.Target is not null)
		{
			@switch (Session.DragOperation.Target)
			{
				case Toolbar toolbar:
					<ToolbarDragPreview Toolbar="toolbar" />
					break;
				case IDockContent dockContent:
					<DockTabDragPreview Content="dockContent" />
					break;
				case DockGrid.Divider:
					break;
				default:
					<div>@Session.DragOperation.Target?.GetType().Name</div>
					break;
			}
		}
	</div>
</div>

@code {
	protected override void OnInitialized()
	{
		Session.RedrawRequested += HandleRedrawRequested;
	}

	private void HandleRedrawRequested(object? sender, EventArgs args)
	{
		_ = InvokeAsync(StateHasChanged);
	}

	private void StopDrag(MouseEventArgs args)
	{
		Session.DragStop(args);
	}

	public void Dispose()
	{
		Session.RedrawRequested -= HandleRedrawRequested;
	}
}
