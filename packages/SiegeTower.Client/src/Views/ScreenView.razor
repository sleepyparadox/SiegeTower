@namespace SiegeTower.Client.Views
@using SiegeTower.Client.Views.Components

<div class="screen-view grid-shell">
    <div class="screen-layer">
        @foreach (var child in Layout.Children.Values)
        {
            @if (child is TitleLayout titleLayout)
            {
                @* Temporary inline title layout while title features migrate. *@
                <header class="screen-title-bar grid-line color-primary">@titleLayout.Title</header>
            }
            else if (child is ToolbarLayout toolbarLayout)
            {
                @* Temporary inline toolbar layout while toolbar features migrate. *@
                <div class="toolbar-layout">
                    @foreach (var toolbarName in new[] { "File", "Edit", "View" })
                    {
                        <div class="toolbar grid-line grid-width-fit">
                            <span class="grid-padded">@toolbarName</span>
                            <button class="toolbar-button button grid-padded" type="button">Action</button>
                        </div>
                    }
                </div>
            }
            else if (child is DockingLayout dockingLayout)
            {
                <DockingLayoutTreeView Layout="@dockingLayout" Session="@Screen.Session" />
            }
        }
    </div>
</div>

@code 
{
    [Parameter, EditorRequired]
    public Screen Screen { get; set; } = default!;

    private ScreenLayout Layout => Screen.SelectComponents<ScreenLayout>().Single();
}