@namespace SiegeTower.Client.Views
@using SiegeTower.Client.Views.Components

<div class="screen-view grid-shell">
    <div class="screen-layer layer-screen">
        <ScreenTitleBarView TitleBar="@TitleBar">
            <NavBurgerMenuView Session="@Screen.Session" Menu="@Menu" />
            <TowerIconView Tower="@Tower" />
            <BreadcrumbsView Breadcrumbs="@Breadcrumbs" Session="@Screen.Session" />
        </ScreenTitleBarView>

        <TabsView Tabs="@Tabs" Session="@Screen.Session" RoleClass="tabs-top" />

        <ToolbarRowsView ToolbarRows="@Toolbars" />

        <DockLayoutView Layout="@DockLayout">
            <div class="dock-row grid-width-fill grid-height-fill">
                <div class="dock-stack dock-width-8">
                    <DockView Dock="@LeftDock" CssClass="dock-fill-height">
                        <TreeView Tree="@FileTree" />
                    </DockView>
                    <DockView Dock="@BarDock" CssClass="dock-height-6">
                        <SubwindowView Subwindow="@OutlineSubwindow">
                            @foreach (var item in Components<Label>().Where(item => item.GetComponent<Element>().Id.StartsWith("outline-")).OrderBy(item => item.GetComponent<Element>().Index))
                            {
                                <LabelView Label="@item" />
                            }
                        </SubwindowView>
                    </DockView>
                </div>
                <DockView Dock="@MiddleDock" CssClass="dock-fill-width">
                    <SubwindowContentView Content="@MiddleContent">
                        <TextView Text="@MiddleText" />
                    </SubwindowContentView>
                </DockView>
                <DockView Dock="@RightDock" CssClass="dock-width-10">
                    <SubwindowView Subwindow="@PropertiesSubwindow">
                        @foreach (var property in Components<Label>().Where(item => item.GetComponent<Element>().Parent.HasValue && item.GetComponent<Element>().Id.StartsWith("property-")).OrderBy(item => item.GetComponent<Element>().Index))
                        {
                            <LabelView Label="@property" />
                        }
                    </SubwindowView>
                </DockView>
            </div>
        </DockLayoutView>
    </div>
    <div class="menu-space" aria-live="polite">
        @if (Menu.IsOpen)
        {
            <MenuView Menu="@Menu" RoleClass="menu-burger color-secondary" AriaLabel="Navigation menu">
                @foreach (var menuItem in RootMenuItems)
                {
                    <NavBurgerItemView MenuItem="@menuItem" Session="@Screen.Session" />
                }
            </MenuView>
        }
    </div>
    <StatusBarView StatusBar="@StatusBar">
        <StatusItemView Item="@Status" />
    </StatusBarView>
</div>

@code {
    [Parameter, EditorRequired]
    public Screen Screen { get; set; } = default!;

    MenuComponent Menu => Screen.SelectComponents<MenuComponent>().Single();

    ScreenTitleBar TitleBar => Component<ScreenTitleBar>("title-bar");
    TowerIcon Tower => Component<TowerIcon>("tower-icon");
    Breadcrumbs Breadcrumbs => Component<Breadcrumbs>("breadcrumbs");
    Tabs Tabs => Component<Tabs>("tabs");
    ToolbarRows Toolbars => Component<ToolbarRows>("toolbars");
    DockLayout DockLayout => Component<DockLayout>("dock-layout");
    Dock LeftDock => Component<Dock>("dock-left");
    Dock BarDock => Component<Dock>("dock-bar");
    Dock MiddleDock => Component<Dock>("dock-middle");
    Dock RightDock => Component<Dock>("dock-right");
    Tree FileTree => Component<Tree>("file-tree");
    SubwindowContent MiddleContent => Component<SubwindowContent>("file-content-window");
    Text MiddleText => Component<Text>("middle-content");
    Subwindow PropertiesSubwindow => Component<Subwindow>("file-properties");
    Subwindow OutlineSubwindow => Component<Subwindow>("file-outline");
    StatusBar StatusBar => Component<StatusBar>("status-bar");
    StatusItem Status => Component<StatusItem>("status");

    IEnumerable<T> Components<T>() where T : Component => Screen.SelectComponents<T>();

    IEnumerable<MenuItemComponent> RootMenuItems => Components<MenuItemComponent>()
        .Where(item => item.GetComponent<Element>().Parent.Get() == Menu.GetComponent<Element>())
        .OrderBy(item => item.GetComponent<Element>().Index);

    T Component<T>(string id) where T : Component
        => Components<T>().Single(component => HasElementId(component, id));

    bool HasElementId(Component component, string id)
        => component.Entity.TryGetComponent(out Element? element) && element is not null && element.Id == id;

    Element Element(TreeNode node) => node.GetComponent<Element>();

    TreeNodeRow NodeRow(TreeNode node) => Component<TreeNodeRow>($"{Element(node).Id}-row");

    TreeNodeLabel NodeLabel(TreeNode node) => Component<TreeNodeLabel>($"{Element(node).Id}-label");

    int Depth(TreeNode node) => node.GetComponent<Element>().Parent.HasValue
        ? node.GetComponent<Element>().Parent.Get()!.Index + 1
        : 0;
}