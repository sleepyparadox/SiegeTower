@namespace SiegeTower.Client.Views.Components

<div class="toolbar grid-line grid-width-fit toolbar-drop-target @(IsDragging ? "is-dragging" : "")">
    <div class="toolbar-drop-zone toolbar-drop-zone-top @DropZoneClass(ToolbarDropPosition.Top)"
        @ondragenter="eventArgs => SetTarget(ToolbarDropPosition.Top, eventArgs)" @ondragover:preventDefault="true" @ondrop="eventArgs => Drop(ToolbarDropPosition.Top, eventArgs)"></div>
    <div class="toolbar-drop-zone toolbar-drop-zone-right @DropZoneClass(ToolbarDropPosition.Right)"
        @ondragenter="eventArgs => SetTarget(ToolbarDropPosition.Right, eventArgs)" @ondragover:preventDefault="true" @ondrop="eventArgs => Drop(ToolbarDropPosition.Right, eventArgs)"></div>
    <div class="toolbar-drop-zone toolbar-drop-zone-bottom @DropZoneClass(ToolbarDropPosition.Bottom)"
        @ondragenter="eventArgs => SetTarget(ToolbarDropPosition.Bottom, eventArgs)" @ondragover:preventDefault="true" @ondrop="eventArgs => Drop(ToolbarDropPosition.Bottom, eventArgs)"></div>
    <div class="toolbar-drop-zone toolbar-drop-zone-left @DropZoneClass(ToolbarDropPosition.Left)"
        @ondragenter="eventArgs => SetTarget(ToolbarDropPosition.Left, eventArgs)" @ondragover:preventDefault="true" @ondrop="eventArgs => Drop(ToolbarDropPosition.Left, eventArgs)"></div>
    <span class="grid-line grid-width-fit grid-center-vertically grid-i-draggable toolbar-grip"
          aria-label="Move toolbar"
        draggable="true"
        @ondragstart="StartDrag"
        @ondragend="CancelDrag">
        <i class="fa-solid fa-grip-vertical" aria-hidden="true"></i>
    </span>
    <button class="toolbar-button button grid-padded" type="button">Action</button>
    <span class="grid-divider toolbar-separator" aria-hidden="true"></span>
    <span class="grid-padded">Toolbar</span>
</div>

@code {
    [Parameter, EditorRequired]
    public Toolbar Toolbar { get; set; } = default!;

    [Parameter, EditorRequired]
    public Session Session { get; set; } = default!;

    private ToolbarDragOperation? DragOperation => Session.ActiveScreen.SelectComponents<ToolbarDragOperation>().SingleOrDefault();

    private bool IsDragging => DragOperation is not null;

    private string DropZoneClass(ToolbarDropPosition position)
        => DragOperation?.TargetToolbar.Get() == Toolbar && DragOperation.TargetPosition == position ? "is-active" : string.Empty;

    private void StartDrag(DragEventArgs eventArgs)
        => Session.HandleEvent(new ToolbarDragStarted(Toolbar, eventArgs));

    private void SetTarget(ToolbarDropPosition position, DragEventArgs eventArgs)
        => Session.HandleEvent(new ToolbarDragTargetChanged(Toolbar, position, eventArgs));

    private void Drop(ToolbarDropPosition position, DragEventArgs eventArgs)
        => Session.HandleEvent(new ToolbarDragStopped(Toolbar, position, eventArgs));

    private void CancelDrag(DragEventArgs eventArgs)
        => Session.HandleEvent(new ToolbarDragCanceled(eventArgs));
}