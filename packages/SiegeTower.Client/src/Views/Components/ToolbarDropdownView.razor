@namespace SiegeTower.Client.Views.Components

<button class="grid-line grid-width-fit grid-center-vertically grid-padded toolbar-dropdown button" type="button">@ChildContent</button>

@code {
    [Parameter, EditorRequired]
    public ToolbarDropdown Dropdown { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}