@namespace SiegeTower.Client.Views.Components

<section class="grid-width-fill tree-node">
    @if (Row is not null && Label is not null)
    {
        <div class="grid-line grid-center-vertically grid-width-fill tree-node-row" style="--tree-depth: @Depth">
            <span class="tree-node-label grid-width-fill grid-wrap-x">@Label.Text</span>
        </div>
    }
    @if (Node.GetComponent<Element>().State.HasFlag(ElementState.Expanded))
    {
        <div class="tree-node-children">
            @foreach (var child in Node.GetComponent<Element>().Children.Values)
            {
                if (child.Entity.TryGetComponent(out TreeNode? node))
                {
                    <TreeNodeView Node="@node" Depth="@(Depth + 1)" />
                }
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public TreeNode Node { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; }

    Element Element => Node.GetComponent<Element>();

    TreeNodeRow? Row => Element.Children.Values
        .Select(child => child.Entity.TryGetComponent(out TreeNodeRow? row) ? row : null)
        .FirstOrDefault(row => row is not null);

    TreeNodeLabel? Label => Row?.GetComponent<Element>().Children.Values
        .Select(child => child.Entity.TryGetComponent(out TreeNodeLabel? label) ? label : null)
        .FirstOrDefault(label => label is not null);
}