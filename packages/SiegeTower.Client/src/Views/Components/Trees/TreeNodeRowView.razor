@namespace SiegeTower.Client.Views.Components

<section class="tree-node">
    <div class="grid-line grid-center-vertically grid-indent tree-node-row @(Node.IsSelected ? "is-selected" : null)"
         style="--grid-indent-depth: @Depth"
         @onclick="(MouseEventArgs args) => Session.HandleEvent(new ClickedEvent(Node, args))">
        @if (HasChildren)
        {
            <button class="tree-node-toggle grid-center-vertically" type="button" aria-label="Expand or collapse node" aria-expanded="@Node.IsExpanded"
                    @onclick="(MouseEventArgs args) => Session.HandleEvent(new TreeNodeToggleEvent(Node, args))"
                    @onclick:stopPropagation="true">
                <i class="tree-node-toggle-icon @(Node.IsExpanded ? "fa-solid fa-chevron-down" : "fa-solid fa-chevron-right")" aria-hidden="true"></i>
            </button>
        }
        else
        {
            <span class="tree-node-toggle grid-center-vertically" aria-hidden="true"></span>
        }
        <i class="tree-node-icon @IconClass" aria-hidden="true"></i>
        <span class="tree-node-label">@Node.Text</span>
    </div>
    @if (Node.IsExpanded)
    {
        <div class="tree-node-children">
            @foreach (var child in Children)
            {
                <TreeNodeRowView Node="@child" Session="@Session" Depth="@(Depth + 1)" />
            }
        </div>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public TreeNode Node { get; set; } = default!;

    [Parameter, EditorRequired]
    public Session Session { get; set; } = default!;

    [Parameter]
    public int Depth { get; set; }

    bool HasChildren => Children.Any();

    string IconClass => Node.Icon switch
    {
        TreeNodeIcon.Folder => "fa-regular fa-folder",
        _ => "fa-regular fa-file"
    };

    IEnumerable<TreeNode> Children => ((IParentOf<TreeNode>)Node).Children.Values;
}