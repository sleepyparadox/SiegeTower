@namespace SiegeTower.Client.Views.Components

<li class="@ElementCss.Classes(Element, "menu-item", "grid-line", "grid-center-vertically", "grid-width-fill")">
    @ChildContent
</li>

@code {
    [Parameter, EditorRequired]
    public MenuItemComponent MenuItem { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    Element Element => MenuItem.GetComponent<Element>();
}