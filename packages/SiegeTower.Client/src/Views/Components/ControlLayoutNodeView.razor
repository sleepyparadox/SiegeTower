@namespace SiegeTower.Client.Views.Components

<div class="control-layout-@Node.Orientation.ToString().ToLowerInvariant()">
    @foreach (var child in ((IParentOf<ControlLayoutNode>)Node).Children.Values)
    {
        <ControlLayoutNodeView Node="@child" />
    }
    @foreach (var control in ((IParentOf<ControlLayoutControl>)Node).Children.Values)
    {
        <ControlLayoutControlView Control="@control" />
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ControlLayoutNode Node { get; set; } = default!;
}