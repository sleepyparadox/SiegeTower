@namespace SiegeTower.Client.Views.Components

<nav class="@ElementCss.Classes(Element, "menu", RoleClass)" aria-label="@AriaLabel">
    <ul>
        @ChildContent
    </ul>
</nav>

@code {
    [Parameter, EditorRequired]
    public MenuComponent Menu { get; set; } = default!;

    [Parameter]
    public string RoleClass { get; set; } = "menu-dropdown";

    [Parameter]
    public string AriaLabel { get; set; } = "Menu";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    Element Element => Menu.GetComponent<Element>();
}