@namespace SiegeTower.Client.Views.Components

<nav class="breadcrumbs grid-line grid-row-layout grid-width-fill grid-center-vertically" aria-label="Breadcrumb">
    <ol>
        @foreach (var child in Breadcrumbs.GetComponent<Element>().Children.Values)
        {
            if (child.Entity.TryGetComponent(out BreadCrumb? breadcrumb))
            {
                <BreadcrumbView BreadCrumb="@breadcrumb" Session="@Session" />
            }
        }
    </ol>
</nav>

@code {
    [Parameter, EditorRequired]
    public Breadcrumbs Breadcrumbs { get; set; } = default!;

    [Parameter, EditorRequired]
    public Session Session { get; set; } = default!;
}