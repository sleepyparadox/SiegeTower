@namespace SiegeTower.Client.Views.Components

<header class="@ElementCss.Classes(Element, "title-bar", "grid-line", "grid-center-vertically")">
    @ChildContent
</header>

@code {
    [Parameter, EditorRequired]
    public ScreenTitleBar TitleBar { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    Element Element => TitleBar.GetComponent<Element>();
}