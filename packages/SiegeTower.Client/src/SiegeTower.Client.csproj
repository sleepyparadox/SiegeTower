<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <BaseOutputPath>../bin/</BaseOutputPath>
    <PublishDir>../dist/</PublishDir>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../SiegeTower.Data/src/SiegeTower.Data.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <Target Name="CopyDataDist"
          BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <DataProject>$(MSBuildThisFileDirectory)..\..\SiegeTower.Data\src\SiegeTower.Data.csproj</DataProject>
      <DataDist>$(MSBuildThisFileDirectory)..\..\SiegeTower.Data\dist\</DataDist>
    </PropertyGroup>

    <MSBuild
      Projects="$(DataProject)"
      Targets="Publish"
      Properties="PublishAfterBuild=true" />

    <ItemGroup>
      <DataDistFiles Include="$(DataDist)**\*" />
    </ItemGroup>

    <Copy
      SourceFiles="@(DataDistFiles)"
      DestinationFiles="@(DataDistFiles->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
    <Copy
      SourceFiles="@(DataDistFiles)"
      DestinationFiles="@(DataDistFiles->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishAfterBuild"
          AfterTargets="Build"
          Condition="'$(PublishAfterBuild)' != 'true'">
    <MSBuild
      Projects="$(MSBuildProjectFullPath)"
      Targets="Publish"
      Properties="PublishAfterBuild=true" />
  </Target>

</Project>
